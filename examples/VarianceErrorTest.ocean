package com.resources;

class Animal { }
class Dog extends Animal { }
class Cat extends Animal { }

// 1. Covariant (+T) in Parameter Position Violation
class BadProducer<+T> {
    void function put(T item) { }
}

// 2. Contravariant (-T) in Return Position Violation
class BadConsumer<-T> {
    T? function get() { return null; }
}

// 3. Invariant generic class
class InvariantBox<T> {
    T item;
}

class VarianceErrorTest {
    static main() {
        // 4. Invariant assignment error: InvariantBox<Dog> cannot be assigned to InvariantBox<Animal>
        InvariantBox<Dog> dogBox = new InvariantBox<Dog>();
        InvariantBox<Animal> animalBox = dogBox;
    }
}
