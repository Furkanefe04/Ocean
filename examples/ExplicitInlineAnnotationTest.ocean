package com.resources;

annotation Inline {
}

class ExplicitInlineAnnotationTest {
    @Inline
    public int function mul(int a, int b) {
        return a*b;
    }

    @Inline
    public int function fib(int n) {
        if (n <= 1) return n;
        return fib(n - 1) + fib(n - 2);
    }

    static main() {
        ExplicitInlineAnnotationTest test = new ExplicitInlineAnnotationTest();
        int r1 = test.mul(5, 10);
        int r2 = test.mul(3, 4);
        int fibRes = test.fib(5);
        
        OceanOutput("mul(5,10)=" + r1 + ", mul(3,4)=" + r2 + ", fib(5)=" + fibRes);
        if (r1 == 50 && r2 == 12 && fibRes == 5) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
