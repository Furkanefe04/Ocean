package com.resources;
    class InterpolationTest {
    static String denemex ="abc";
    main() {
        variable name = "Ocean";
        variable version = 1.1;
        
        // Basic interpolation
        variable msg = $"Hello {name}, version {version},deneme {denemex}";
        OceanOutput(msg);
        
        // Expression interpolation
        variable res1 = $"Result: {(10 + 20 * 3)+version}";
        OceanOutput(res1);
        
        // Escaping
        variable res2 = $"Literal braces: {{ and }}";
        OceanOutput(res2);
        
        // Nested expressions with strings
        variable res3 = $"Status: { (version > 1.0 ? "Modern" : "Old") }";
        OceanOutput(res3);

        if (msg == "Hello Ocean, version 1.1,deneme abc" && res1 == "Result: 71.1" && res2 == "Literal braces: { and }" && res3 == "Status: Modern") {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
