package com.resources;

import java.util.Objects;


@Inline
class UserId {
    public int id;
    function UserId(int id) {
        this.id = id;
    }
}

@Inline
class Price {
    public double amount;
    function Price(double amount) {
        this.amount = amount;
    }
}

class EscapeAnalysisFailedBenchmark {

    static main() {
        OceanOutput("=== ESCAPE ANALYSIS FAILED BENCHMARK (@Inline) START ===");
        long start = System.nanoTime();

        int size = 5000000; // 5 Milyon Elemanlı Dizi (Escaping to Array)
        UserId[] userArray = new UserId[size];
        Price[] priceArray = new Price[size];

        // 1. Fill Arrays with @Inline Value Instances (Zero Heap Objects)
        int i = 0;
        while (i < size) {
            userArray[i] = new UserId(i);
            priceArray[i] = new Price((double) (i % 100));
            i = i + 1;
        }

        // 2. Iterate and Aggregate Escaped Array Elements
        long sumIds = 0;
        double sumPrices = 0.0;
        int j = 0;

        while (j < size) {
            sumIds = sumIds + userArray[j].id;
            sumPrices = sumPrices + priceArray[j].amount;
            j = j + 1;
        }

        long durationMs = (System.nanoTime() - start) / 1000000;
        OceanOutput("Duration (@Inline Escaping Array): " + durationMs + " ms");
        OceanOutput("Sum IDs: " + sumIds);
        OceanOutput("Sum Prices: " + sumPrices);

        if (sumIds > 0 && sumPrices > 0.0) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
