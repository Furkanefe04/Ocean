package tests;

class HelperMainClass {
    static String function mainx() {
        return "Helper main OK";
    }
}

class MainArgsVerificationTest {
     main() {
        String helperResult = HelperMainClass.mainx();
        OceanOutput("Helper result: " + helperResult);
