package tests;

class ArrayCharLoopTest {
    static main() {
        char[] chars = new char[3];
        chars[0] = 'a';
        chars[1] = 'b';
        chars[2] = 'c';
        
        String res = "";
        for (char c in chars) {
            res = res + c;
        }
        OceanOutput("chars: " + res);
        if (res.equals("abc")) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
