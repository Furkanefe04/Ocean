package com.resources;
    class AllocNode {
    variable a = 0;
    variable b = 0;
}

class AllocBench {
    static main() {
        long start = System.nanoTime();
        int sum = 0;
        int iterations = 50000000;
        for (int i from 1 to iterations with increasing 1) {
            AllocNode n = new AllocNode();
            n.a = i;
            n.b = i + 1;
            // Simplified check to avoid VerifyError in certain nested contexts
            if (i == 49999999) {
                int tempA = n.a;
                int tempB = n.b;
                sum = tempA + tempB;
            }
        }
        long end = System.nanoTime();
        long durMs = (end - start) / 1000000;
        OceanOutput("==============================================");
        OceanOutput("  OCEAN OBJECT ALLOC (50M) BENCHMARK");
        OceanOutput("  Sure: " + durMs + " ms");
        OceanOutput("  Hesap: " + sum);
        OceanOutput("==============================================");
        if (sum == 99999999) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
