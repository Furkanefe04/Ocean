    static void function test(String barcode, int index) {
        OceanOutput(index + "/100 -> " + barcode + " sorgulaniyor...");
        fetchProductData(barcode);
    }

    static void function fetchProductData(String barcode) {
        String json = fetchOFF(barcode);
        if (json.indexOf("\"product\":") != -1) {
            parseAndPrint(json, "Open Food Facts");
            return;
        }
        
        json = fetchUPC(barcode);
        if (json.indexOf("\"total\":0") == -1 && json.length() > 50) {
            parseAndPrint(json, "UPCitemdb");
            return;
        }
        
        OceanOutput("  [MISS] Bulunamadi.");
    }

    static String function fetchOFF(String barcode) {
        String res = "";
        trying {
            URL url = new URL("https://world.openfoodfacts.org/api/v2/product/" + barcode + ".json");
            URLConnection conn = url.openConnection();
            conn.setRequestProperty("User-Agent", "OceanBenchmark/1.0");
            Scanner s = new Scanner(conn.getInputStream());
            while (s.hasNextLine()) {
                res = res + s.nextLine();
            }
            s.close();
        } catch(Exception e) {}
        return res;
    }

    static String function fetchUPC(String barcode) {
        String res = "";
        trying {
            URL url = new URL("https://api.upcitemdb.com/prod/trial/lookup?upc=" + barcode);
            URLConnection conn = url.openConnection();
            conn.setRequestProperty("User-Agent", "OceanBenchmark/1.0");
            Scanner s = new Scanner(conn.getInputStream());
            while (s.hasNextLine()) {
                res = res + s.nextLine();
            }
            s.close();
        } catch(Exception e) {}
        return res;
    }

    static void function parseAndPrint(String json, String source) {
        int start = json.indexOf("product_name\":\"");
        if (start == -1) {
            int startUPC = json.indexOf("title\":\"");
            if (startUPC != -1) {
                int endUPC = json.indexOf("\"", startUPC + 8);
                OceanOutput("  [HIT] " + source + " -> " + json.substring(startUPC + 8, endUPC));
            }
        } else {
            int end = json.indexOf("\"", start + 15);
            OceanOutput("  [HIT] " + source + " -> " + json.substring(start + 15, end));
        }
    }
