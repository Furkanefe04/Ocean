package tests;

class NullSafetySuccessTest {
    main() {
        String s = "Hello";
        int len = s.length();
        OceanOutput("Length: " + len);

        String? n = null;
        int len2 = 0;
        if (n != null) {
            len2 = n.length();
        }
        OceanOutput("Safe length: " + len2);

        String? n3 = null;
        String nonNull = n3 ?? "Default";
        OceanOutput("Coalesced: " + nonNull.length());
    }
}
