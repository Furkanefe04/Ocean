package com.resources;

class OceanBench2BubbleSort {
    static main() {
        int n = 6000;
        int[] arr = new int[n];
        for (int i from 0 to n - 1 with increasing 1) {
            arr[i] = n - i;
        }
        long start = System.nanoTime();
        for (int i from 0 to n - 2 with increasing 1) {
            for (int j from 0 to n - i - 2 with increasing 1) {
                if (arr[j] > arr[j + 1]) {
                    int tmp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = tmp;
                }
            }
        }
        long end = System.nanoTime();
        OceanOutput("sorted[0]=" + arr[0] + " sorted[last]=" + arr[n - 1] + " | time_ms=" + ((end - start) / 1000000));
    }
}
