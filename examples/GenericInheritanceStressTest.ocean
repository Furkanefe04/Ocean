package com.ultra;

import java.util.*;

// ============================================================
// 1. F-BOUNDED CHAIN
// ============================================================

interface ChainNode<T <: ChainNode<T>> {
    T function next();
    void function link(T node);
}

class ChainBase<T <: ChainBase<T>> implements ChainNode<T> {

    T nextNode;

    public void function link(T node) {
        nextNode = node;
    }

    @Override
    public T function next() {
        return nextNode;
    }
}

class ChainMiddle<T <: ChainMiddle<T>> extends ChainBase<T> {}

class ChainLeaf extends ChainMiddle<ChainLeaf> {

    String name;

    function ChainLeaf(String name) {
        this.name = name;
    }

    String function getName() {
        return name;
    }
}


// ============================================================
// 2. MULTI PARAMETER GENERIC INHERITANCE
// ============================================================

class TripleBox<A, B, C> {

    A firstValue;
    B secondValue;
    C thirdValue;

    function TripleBox(A a, B b, C c) {
        firstValue = a;
        secondValue = b;
        thirdValue = c;
    }

    A function first() {
        return firstValue;
    }

    B function second() {
        return secondValue;
    }

    C function third() {
        return thirdValue;
    }
}

class StringIntegerDoubleBox<X> extends TripleBox<X, Integer, Double> {

    function StringIntegerDoubleBox(X x, Integer i, Double d) {
        super(x, i, d);
    }
}


// ============================================================
// 3. DEEP GENERIC INHERITANCE
// ============================================================

class L1<T> {

    T valuex;

    function L1(T valuex) {
        this.valuex = valuex;
    }

    T function get() {
        return valuex;
    }

    void function set(T valuex) {
        this.valuex = valuex;
    }
}

class L2<T> extends L1<T> {

    function L2(T valuex) {
        super(valuex);
    }
}

class L3<T> extends L2<T> {

    function L3(T valuex) {
        super(valuex);
    }
}

class L4<T> extends L3<T> {

    function L4(T valuex) {
        super(valuex);
    }
}

class L5<T> extends L4<T> {

    function L5(T valuex) {
        super(valuex);
    }
}

class FinalStringNode extends L5<String> {

    function FinalStringNode(String valuex) {
        super(valuex);
    }
}


// ============================================================
// 4. GENERIC INTERFACE CHAIN
// ============================================================

interface Producer<T> {
    T function produce();
}

interface Transformer<A, B> {
    B function transform(A valuex);
}

interface AdvancedProducer<T> extends Producer<T> {

    T function produceAgain();
}

class StringAdvancedProducer implements AdvancedProducer<String> {

    public String function produce() {
        return "PRODUCED";
    }

    public String function produceAgain() {
        return "PRODUCED_AGAIN";
    }
}


// ============================================================
// 5. GENERIC INTERFACE THROUGH ABSTRACT CLASS
// ============================================================

abstract class AbstractTransformer<A, B> implements Transformer<A, B> {

    A stored;

    function AbstractTransformer(A valuex) {
        stored = valuex;
    }

    A function getInput() {
        return stored;
    }
}

class IntToStringTransformer extends AbstractTransformer<Integer, String> {

    function IntToStringTransformer(Integer valuex) {
        super(valuex);
    }

    @Override
    public String function transform(Integer valuex) {
        return $"VALUE_{valuex}";
    }
}


// ============================================================
// 6. NESTED GENERICS
// ============================================================

class Box<T> {

    T valuex;

    function Box(T valuex) {
        this.valuex = valuex;
    }

    T function get() {
        return valuex;
    }

    void function set(T valuex) {
        this.valuex = valuex;
    }
}

class NestedContainer<T> {

    Box<T> box;

    function NestedContainer(T valuex) {
        box = new Box<T>(valuex);
    }

    Box<T> function getBox() {
        return box;
    }

    T function getValue() {
        return box.get();
    }
}


// ============================================================
// 7. GENERIC METHOD SHADOWING
// ============================================================

class Shadow<T> {

    T classValue;

    function Shadow(T valuex) {
        classValue = valuex;
    }

    T function getClassValue() {
        return classValue;
    }

    public <U> U function identity(U valuex) {
        return valuex;
    }

    public <U> Box<U> function wrap(U valuex) {
        return new Box<U>(valuex);
    }
}


// ============================================================
// 8. GENERIC METHOD RETURN CHAIN
// ============================================================

class ChainBox<T> {

    T valuex;

    function ChainBox(T valuex) {
        this.valuex = valuex;
    }

    T function get() {
        return valuex;
    }

    Box<T> function boxed() {
        return new Box<T>(valuex);
    }
}


// ============================================================
// 9. GENERIC SUPER CALL
// ============================================================

class Parent<T> {

    T valuex;

    function Parent(T valuex) {
        this.valuex = valuex;
    }

    T function get() {
        return valuex;
    }

    void function set(T valuex) {
        this.valuex = valuex;
    }
}

class Child<T> extends Parent<T> {

    function Child(T valuex) {
        super(valuex);
    }

    T function childGet() {
        return super.get();
    }

    void function childSet(T valuex) {
        super.set(valuex);
    }
}

class ConcreteChild extends Child<String> {

    function ConcreteChild(String valuex) {
        super(valuex);
    }
}


// ============================================================
// 10. MULTI LEVEL TYPE TRANSFORMATION
// ============================================================

class Mapper<A, B> {

    A input;
    B output;

    function Mapper(A input, B output) {
        this.input = input;
        this.output = output;
    }

    A function getInput() {
        return input;
    }

    B function getOutput() {
        return output;
    }
}

class StringIntegerMapper extends Mapper<String, Integer> {

    function StringIntegerMapper(String s, Integer i) {
        super(s, i);
    }
}


// ============================================================
// 11. STATIC GENERIC METHODS
// ============================================================

class GenericMath {

    public static <T> T function echo(T valuex) {
        return valuex;
    }

    public static <A, B> Box<A> function firstBox(Box<A> a, Box<B> b) {
        return a;
    }
}


// ============================================================
// 12. MAIN STRESS TEST
// ============================================================

class GenericInheritanceStressTest {

    main() {

        OceanOutput("========================================");
        OceanOutput(" GENERIC INHERITANCE STRESS TEST");
        OceanOutput("========================================");


// --------------------------------------------------------
// TEST 1 - F-BOUNDED
// --------------------------------------------------------

        ChainLeaf n1 = new ChainLeaf("NODE_1");
        ChainLeaf n2 = new ChainLeaf("NODE_2");

        n1.link(n2);

        ChainLeaf recursive = n1.next();

        OceanOutput(recursive.getName());


// --------------------------------------------------------
// TEST 2 - DEEP F-BOUNDED CHAIN
// --------------------------------------------------------

        ChainLeaf n3 = new ChainLeaf("NODE_3");

        n2.link(n3);

        String deepRecursive = n1.next().next().getName();

        OceanOutput(deepRecursive);


// --------------------------------------------------------
// TEST 3 - MULTI PARAMETER GENERIC INHERITANCE
// --------------------------------------------------------

        StringIntegerDoubleBox<String> triple = new StringIntegerDoubleBox<String>("TRIPLE", 123, 45.5);

        String tripleA = triple.first();
        Integer tripleB = triple.second();
        Double tripleC = triple.third();

        OceanOutput(tripleA);
        OceanOutput(tripleB);
        OceanOutput(tripleC);


// --------------------------------------------------------
// TEST 4 - FIVE LEVEL GENERIC INHERITANCE
// --------------------------------------------------------

        FinalStringNode deep = new FinalStringNode("DEEP_STRING");

        String deepValue = deep.get();

        OceanOutput(deepValue);

        deep.set("DEEP_CHANGED");

        String deepChanged = deep.get();

        OceanOutput(deepChanged);


// --------------------------------------------------------
// TEST 5 - GENERIC INTERFACE
// --------------------------------------------------------

        Producer<String> producer = new StringAdvancedProducer();

        String produced = producer.produce();

        OceanOutput(produced);


// --------------------------------------------------------
// TEST 6 - GENERIC INTERFACE SECOND METHOD
// --------------------------------------------------------

        AdvancedProducer<String> advanced = new StringAdvancedProducer();

        String producedAgain = advanced.produceAgain();

        OceanOutput(producedAgain);


// --------------------------------------------------------
// TEST 7 - GENERIC INTERFACE + ABSTRACT CLASS
// --------------------------------------------------------

        Transformer<Integer, String> transformer = new IntToStringTransformer(777);

        String transformed = transformer.transform(777);

        OceanOutput(transformed);


// --------------------------------------------------------
// TEST 8 - ABSTRACT GENERIC FIELD
// --------------------------------------------------------

        IntToStringTransformer concreteTransformer = new IntToStringTransformer(888);

        Integer originalInput = concreteTransformer.getInput();

        OceanOutput(originalInput);


// --------------------------------------------------------
// TEST 9 - NESTED GENERIC
// --------------------------------------------------------

        NestedContainer<String> nested = new NestedContainer<String>("NESTED");

        Box<String> nestedBox = nested.getBox();

        String nestedValue = nestedBox.get();

        OceanOutput(nestedValue);


// --------------------------------------------------------
// TEST 10 - NESTED GENERIC DIRECT CHAIN
// --------------------------------------------------------

        String nestedDirect = nested.getBox().get();

        OceanOutput(nestedDirect);


// --------------------------------------------------------
// TEST 11 - CLASS GENERIC + METHOD GENERIC
// --------------------------------------------------------

        Shadow<String> shadow = new Shadow<String>("CLASS_VALUE");

        String classValue = shadow.getClassValue();

        Integer shadowInt = shadow.identity(Integer.valueOf(999));

        Double shadowDouble = shadow.identity(Double.valueOf(14.25));

        OceanOutput(classValue);
        OceanOutput(shadowInt);
        OceanOutput(shadowDouble);


// --------------------------------------------------------
// TEST 12 - GENERIC METHOD RETURNS GENERIC CLASS
// --------------------------------------------------------

        Box<String> wrapped = shadow.wrap("WRAPPED");

        String wrappedValue = wrapped.get();

        OceanOutput(wrappedValue);


// --------------------------------------------------------
// TEST 13 - GENERIC RETURN CHAIN
// --------------------------------------------------------

        ChainBox<String> chainBox = new ChainBox<String>("CHAIN_VALUE");

        String chainValue = chainBox.get();

        OceanOutput(chainValue);


// --------------------------------------------------------
// TEST 14 - GENERIC RETURN -> BOX -> VALUE
// --------------------------------------------------------

        String boxedChain = chainBox.boxed().get();

        OceanOutput(boxedChain);


// --------------------------------------------------------
// TEST 15 - GENERIC SUPER
// --------------------------------------------------------

        ConcreteChild child = new ConcreteChild("CHILD_VALUE");

        String childValue = child.childGet();

        OceanOutput(childValue);


// --------------------------------------------------------
// TEST 16 - GENERIC SUPER SET
// --------------------------------------------------------

        child.childSet("CHANGED_CHILD");

        String changedChild = child.childGet();

        OceanOutput(changedChild);


// --------------------------------------------------------
// TEST 17 - MULTI PARAMETER INHERITANCE
// --------------------------------------------------------

        StringIntegerMapper mapper = new StringIntegerMapper("MAPPED", 2026);

        String mappedInput = mapper.getInput();

        Integer mappedOutput = mapper.getOutput();

        OceanOutput(mappedInput);
        OceanOutput(mappedOutput);


// --------------------------------------------------------
// TEST 18 - STATIC GENERIC
// --------------------------------------------------------

        String staticString = GenericMath.echo("STATIC");

        Integer staticInteger = GenericMath.echo(12345);

        Double staticDouble = GenericMath.echo(99.5);

        OceanOutput(staticString);
        OceanOutput(staticInteger);
        OceanOutput(staticDouble);


// --------------------------------------------------------
// TEST 19 - STATIC GENERIC NESTED
// --------------------------------------------------------

        Box<String> boxA = new Box<String>("BOX_A");

        Box<Integer> boxB = new Box<Integer>(555);

        Box<String> first = GenericMath.firstBox(boxA, boxB);

        String firstValue = first.get();

        OceanOutput(firstValue);


// --------------------------------------------------------
// TEST 20 - EXTREME CHAIN
// --------------------------------------------------------

        String extreme = new NestedContainer<String>("EXTREME").getBox().get();

        OceanOutput(extreme);


// --------------------------------------------------------
// FINAL VALIDATION
// --------------------------------------------------------

        if (recursive.getName().equals("NODE_2") && deepRecursive.equals("NODE_3")
            && tripleA.equals("TRIPLE") && tripleB == 123 && tripleC == 45.5
            && deepValue.equals("DEEP_STRING") && deepChanged.equals("DEEP_CHANGED")
            && produced.equals("PRODUCED") && producedAgain.equals("PRODUCED_AGAIN")
            && transformed.equals("VALUE_777") && originalInput == 888 && nestedValue.equals("NESTED")
            && nestedDirect.equals("NESTED") && classValue.equals("CLASS_VALUE")
            && shadowInt == 999 && shadowDouble == 14.25 && wrappedValue.equals("WRAPPED")
            && chainValue.equals("CHAIN_VALUE") && boxedChain.equals("CHAIN_VALUE")
            && childValue.equals("CHILD_VALUE") && changedChild.equals("CHANGED_CHILD")
            && mappedInput.equals("MAPPED") && mappedOutput == 2026 && staticString.equals("STATIC")
            && staticInteger == 12345 && staticDouble == 99.5 && firstValue.equals("BOX_A") && extreme.equals("EXTREME")) {
                OceanOutput("STATUS: PASSED");
        } else {
                OceanOutput("STATUS: FAILED");
        }
        OceanOutput("========================================");
        OceanOutput(" GENERIC INHERITANCE STRESS TEST END");
        OceanOutput("========================================");
    }
}