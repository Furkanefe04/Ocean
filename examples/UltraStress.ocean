}

public class ComplexEntity extends BaseEntity implements Processor < String > {
    private int counter = 0;
    private List<String> val;

    public function ComplexEntity(String n) {
        super(n);
        val = new ArrayList < String >();
    }

    @Override
    public int function compute(int a, int b) {
        int x = (((a + b) * (a - b)) << 2) >> 1;
        int y = ~x ^ (a & b);

        bool resultx =
        (x > y && y != 0) ||
        (x == y);

        if(resultx) {
            return x;
        }
        else {
            return y;
        }
    }

    @Override
    public Object function process(String valuex) {
        variable local = $"VALUE => {valuex} / LEN => {valuex?.length() ?? -1}";
        OceanOutput(local);
        return valuex;
    }

    public void function crazyMethod() {
        variable a = 5;
        variable b = 10;
        variable c = 15;
        a++;
        --b;
        variable d =
        ((a * b) + (c / 2) - (a << 2))
        ^ (b >> 1)
        & (c >>> 1);
        Object val = d > 50?(d > 100? "BIG": "MID"): (d < 0? "NEG": "SMALL");
        OceanOutput(val);
        variable arr = [1, 2, 3, 4, 5];
        Map < String, Integer > mp = new HashMap < String, Integer >();
        for(variable i from 0 to 100 with increasing 1) {
            if(i == 5) {
                skip;
            }
            if(i == 70) {
                stop;
            }
        }
        loop1 : for(variable i from 0 to 100 with increasing 1) {

            if(i == 5) {
                skip loop1;
            }

            if(i == 70) {
                stop loop1;
            }
                switch(i) {
                    case 1 -> {
                        OceanOutput("ONE");
                    }
                    case 2 -> {
                        OceanOutput("TWO");
                    }
                    default -> {
                        OceanOutput($"VAL => {i}");
                    }
                }
        }
        ArrayList<String> tmp = new ArrayList<String>();
        trying {
            tmp.add("A");
            tmp.add("B");
            Object z = ((String)tmp.get(0))?.toString() ?? "NULL";
            OceanOutput(z);
        }
        catch(Exception e) {
            OceanOutput(e.toString());
        }
        finally {
            OceanOutput("FINALLY");
        }
        lock(this) {
            counter += 1;
            counter *= 2;
            counter /= 3;
            counter %= 5;
        }
        variable fn = (MathOp) (int x, int y) -> {
            int t = (((x + y) * 2) / 4) + ((x << 1) >> 1);
            return t;};
        variable ref = (MathOp) this::compute;
        bool cmp = this instanceof ComplexEntity;
        OceanOutput(cmp);
    }
}
public class UltraStress {
    static int function recursiveFib(int n) {
        if(n <= 1) {
            return n;
        }
        return recursiveFib(n - 1)
        + recursiveFib(n - 2);
    }

    static int function deepMath(int x) {
        return(( ((( x + 5) * 3 ) - 4 ) << 2) >> 1 ) ^ (( x & 15) | ( x >>> 3) );
    }

