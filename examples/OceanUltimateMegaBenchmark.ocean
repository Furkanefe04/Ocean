package com.resources;

import java.util.Objects;

class OceanUltimateMegaBenchmark {

    // Single-call-site helper method targeted for 100% method inlining
    private int function inlineMathHelper(int a, int b) {
        return (a * 5 + b * 11) % 10007;
    }

    // Helper method for array & string processing
    private String function formatData(String prefix, int val) {
        return prefix + ":" + val;
    }

    static main() {
        OceanOutput("=== OCEAN ULTIMATE MEGA BENCHMARK START ===");
        long start = System.nanoTime();

        // 1. ALL AOT STRING METHOD FOLDING
        String s1 = "ocean compiler framework".toUpperCase();      // "OCEAN COMPILER FRAMEWORK"
        String s2 = "OCEAN COMPILER FRAMEWORK".toLowerCase();      // "ocean compiler framework"
        String s3 = "  ocean compiler  ".trim();                   // "ocean compiler"
        String s4 = "ocean compiler".substring(0, 5);              // "ocean"
        String s5 = "abc".repeat(4);                               // "abcabcabcabc"
        String s6 = "ocean v1".replace("v1", "v2");               // "ocean v2"
        bool b1 = "ocean compiler".startsWith("ocean");            // true
        bool b2 = "ocean compiler".endsWith("compiler");           // true
        int sLen = "ocean".length();                               // 5

        // 2. ALL AOT MATH & BITWISE CONSTANT FOLDING
        int absVal = Math.abs(-100);                               // 100
        int minVal = Math.min(45, 90);                             // 45
        int maxVal = Math.max(45, 90);                             // 90
        int sqrtVal = (int) Math.sqrt(100.0);                      // 10
        int powVal = (int) Math.pow(2.0, 5.0);                     // 32
        int bitAnd = 255 & 15;                                     // 15
        int bitOr = 16 | 8;                                        // 24
        int bitXor = 255 ^ 15;                                     // 240
        int bitShift = 1 << 4;                                     // 16
        int foldedMathSum = absVal + minVal + maxVal + sqrtVal + powVal + bitAnd + bitOr + bitXor + bitShift; // 572

        // 3. COLLECTION PRE-ALLOCATION (List, Set #{}, Map)
        OceanList list = [100, 200, 300, 400, 500];
        OceanSet set = #{1000, 2000, 3000};
        OceanMap map = {"k1": 10, "k2": 20, "k3": 30, "k4": 40};

        // 4. MULTIDIMENSIONAL ARRAY ALLOCATION & MANIPULATION
        int[] arr1D = new int[5];
        arr1D[0] = 10; arr1D[1] = 20; arr1D[2] = 30; arr1D[3] = 40; arr1D[4] = 50;
        int arrLen = arr1D.length;

        // 5. 100 MILLION ITERATION HIGH-FREQUENCY LOOP (Inlining + Direct Short-Circuit Jumps)
        OceanUltimateMegaBenchmark bench = new OceanUltimateMegaBenchmark();
        int checksum = 0;
        int i = 0;
        int iterations = 100000000; // 100 Milyon Iteration

        while (i < iterations) {
            // Method inlining eliminates call overhead
            int val = bench.inlineMathHelper(i, checksum);

            // Direct Short-Circuit Branching: zero bool stack push
            if (i > 0 && val >= 0 && val < 10007 && (i % 2 == 0 || val % 2 == 0) && (i % 3 == 0 || val % 3 == 0)) {
                checksum = (checksum + val) % 10000007;
            } else {
                checksum = (checksum + 3) % 10000007;
            }

            i = i + 1;
        }

        // 6. SAFE-CALL & SMART-CAST VERIFICATION
        OceanList? safeList = list;
        int safeSize = safeList?.size() ?? 0;

        long durationMs = (System.nanoTime() - start) / 1000000;
        OceanOutput("Ocean Ultimate Mega Benchmark Execution Time: " + durationMs + " ms");
        OceanOutput("Final Checksum: " + checksum);
        OceanOutput("Folded Math Sum: " + foldedMathSum);
        OceanOutput("String Substring: " + s4);
        OceanOutput("String Repeat: " + s5);
        OceanOutput("List Size: " + list.size());
        OceanOutput("Set Size: " + set.size());
        OceanOutput("Map Size: " + map.size());
        OceanOutput("Safe Size: " + safeSize);

        if (checksum > 0 && foldedMathSum == 572 && s4.equals("ocean") && s5.equals("abcabcabcabc") &&
            b1 && b2 && list.size() == 5 && set.size() == 3 && map.size() == 4 && safeSize == 5) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
