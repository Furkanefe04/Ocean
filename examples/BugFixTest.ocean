package com.resources;
    class BugFixTest {
    static bool lambdaChecked = false;

    static main() {
        variable obj = new Object();
        int counter = 0;
        
        while (counter < 10) {
            lock (obj) {
                counter = counter + 1;
                OceanOutput("Counter: " + counter);
                if (counter == 5) {
                    OceanOutput("Breaking from lock block");
                    stop; // Should release lock!
                }
            }
        }
        OceanOutput("Out of loop");
        
        // If lock was not released, the next lock would hang or fail in some environments
        // (though on JVM Reentrant locks would work, but we want to be sure MONITOREXIT was called)
        lock (obj) {
            OceanOutput("Re-locked successfully");
        }
        
        testLambdaCapture();

        if (counter == 5 && lambdaChecked) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
    
    static void function testLambdaCapture() {
        variable x = 10;
        variable lambda = (Runnable) () -> {
            OceanOutput("Captured x: " + x);
            if (x == 10) {
                lambdaChecked= true;
            }
        };
        lambda();
    }
}