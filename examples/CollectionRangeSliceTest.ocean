package com.resources;

class CollectionRangeSliceTest {
    static main() {
        OceanOutput("=== COLLECTION RANGE SLICE VERIFICATION ===");

        // 1. String Slicing (Inclusive 0..4 -> 'Hello')
        String greeting = "Hello Ocean World";
        String hello = greeting[0..4];
        String ocean = greeting[6..10];
        OceanOutput("Sliced String 0..4: '" + hello + "'");
        OceanOutput("Sliced String 6..10: '" + ocean + "'");

        // 2. OceanList Slicing (Inclusive 1..3 -> 20, 30, 40)
        variable list = [10, 20, 30, 40, 50];
        variable subList = list[1..3];
        OceanOutput("SubList size: " + subList.size());
        OceanOutput("SubList item 0: " + subList.get(0));
        OceanOutput("SubList item 2: " + subList.get(2));

        // 3. Array Slicing (Inclusive 0..2)
        int[] numbers = new int[5];
        numbers[0] = 100;
        numbers[1] = 200;
        numbers[2] = 300;
        numbers[3] = 400;
        numbers[4] = 500;

        int[] slicedArray = numbers[0..2];
        OceanOutput("Sliced Array length: " + slicedArray.length);
        OceanOutput("Sliced Array index 0: " + slicedArray[0]);
        OceanOutput("Sliced Array index 2: " + slicedArray[2]);

        bool p1 = hello.equals("Hello") && ocean.equals("Ocean");
        bool p2 = subList.size() == 3 && (int) subList.get(0) == 20 && (int) subList.get(2) == 40;
        bool p3 = slicedArray.length == 3 && slicedArray[0] == 100 && slicedArray[2] == 300;

        OceanOutput("P1 String Slice: " + p1);
        OceanOutput("P2 List Slice: " + p2);
        OceanOutput("P3 Array Slice: " + p3);

        if (p1 && p2 && p3) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
