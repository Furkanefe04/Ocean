package com.enterprise.core;

public interface Identifiable {
    String function getId();
}

public class CoreEntity implements Identifiable {
    public String id;

    @Override
    public String function getId() {
        return id;
    }
}

public class Result<T> {
    public T data;
    public bool success;
    public String message;

    public static <D> Result<D> function ok(D payload, String msg) {
        Result<D> r = new Result<D>();
        r.data = payload;
        r.success = true;
        r.message = msg;
        return r;
    }

    public static <D> Result<D> function fail(String msg) {
        Result<D> r = new Result<D>();
        r.success = false;
        r.message = msg;
        return r;
    }
}
