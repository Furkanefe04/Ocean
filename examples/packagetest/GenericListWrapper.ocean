package com.enterprise.core;

import java.util.ArrayList;

public class GenericListWrapper<T> {
    ArrayList<T> list;

    public static <E> GenericListWrapper<E> function create() {
        GenericListWrapper<E> w = new GenericListWrapper<E>();
        w.list = new ArrayList<E>();
        return w;
    }

    public void function add(T item) {
        list.add(item);
    }

    public T function get(int idx) {
        return (T) list.get(idx);
    }

    public int function size() {
        return list.size();
    }
}
