package com.resources;

class Calculator {
    static int function add(int a, int b = 10, int c = 20) {
        return a + b + c;
    }
}

class DefaultParamTest {
    main() {
        variable r1 = Calculator.add(5);           // 5 + 10 + 20 = 35
        variable r2 = Calculator.add(5, 15);       // 5 + 15 + 20 = 40
        variable r3 = Calculator.add(5, 15, 25);   // 5 + 15 + 25 = 45

        if (r1 == 35 && r2 == 40 && r3 == 45) {
            Output("STATUS: PASSED - Default Parameters Validated");
        } else {
            Output("STATUS: FAILED");
        }
    }
}
