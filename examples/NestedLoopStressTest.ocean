package com.resources;

class NestedLoopStressTest {
    main() {
        OceanOutput("=== NESTED LOOP STRESS TEST START ===");

        int outerCount = 0;
        outerLoop: for (int i from 1 to 5 with increasing 1) {
            for (int j from 1 to 5 with increasing 1) {
                if (i == 3 && j == 2) {
                    OceanOutput("Breaking outer loop at i=3, j=2");
                    stop outerLoop;
                }
                outerCount = outerCount + 1;
            }
        }
        OceanOutput("Total iterations before labeled stop: " + outerCount);

        int skipCount = 0;
        outerSkip: for (int i from 1 to 3 with increasing 1) {
            for (int j from 1 to 3 with increasing 1) {
                if (j == 2) {
                    skip outerSkip;
                }
                skipCount = skipCount + 1;
            }
        }
        OceanOutput("Total iterations after labeled skip: " + skipCount);

        if (outerCount == 9 && skipCount == 2) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
