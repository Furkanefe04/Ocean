package com.resources;

import com.resources.Wallet;

class OrderBook {
    variable exchangeName = "";
    variable feePercent = 0;
    variable totalOrders = 0;
    variable totalVolumeTRY = 0;
    variable totalFeesCollected = 0;

    function OrderBook(String name, int fee) {
        exchangeName = name;
        feePercent = fee;
        totalOrders = 0;
        totalVolumeTRY = 0;
        totalFeesCollected = 0;
    }

    int function calculateFee(int amount) {
        return (amount * feePercent) / 100;
    }

    int function buyBTC(Wallet buyer, int amountTRY, int btcPrice) {
        variable fee = calculateFee(amountTRY);
        variable totalCost = amountTRY + fee;
        if(!buyer.isVerified()) {
            return 0;
        }
        if(buyer.withdrawTRY(totalCost) == 1) {
            variable btcAmount = (amountTRY * 100000) / btcPrice;
            buyer.addBTC(btcAmount);
            totalOrders = totalOrders + 1;
            totalVolumeTRY = totalVolumeTRY + amountTRY;
            totalFeesCollected = totalFeesCollected + fee;
            return 1;
        }
        return 0;
    }

    int function buyETH(Wallet buyer, int amountTRY, int ethPrice) {
        variable fee = calculateFee(amountTRY);
        variable totalCost = amountTRY + fee;
        if(!buyer.isVerified()) {
            return 0;
        }
        if(buyer.withdrawTRY(totalCost) == 1) {
            variable ethAmount = (amountTRY * 100000) / ethPrice;
            buyer.addETH(ethAmount); totalOrders = totalOrders + 1;
            totalVolumeTRY = totalVolumeTRY + amountTRY;
            totalFeesCollected = totalFeesCollected + fee;
            return 1;
        }
        return 0;
    }

    int function sellBTC(Wallet seller, int satoshiAmount, int btcPrice) {
        variable fee = (satoshiAmount * btcPrice) / 100000;
        fee = calculateFee(fee);
        if(!seller.isVerified()) {
            return 0;
        }
        if(seller.removeBTC(satoshiAmount) == 1) {
            variable tryAmount = (satoshiAmount * btcPrice) / 100000;
            variable netAmount = tryAmount - fee; seller.depositTRY(netAmount);
            totalOrders = totalOrders + 1;
            totalVolumeTRY = totalVolumeTRY + tryAmount;
            totalFeesCollected = totalFeesCollected + fee;
            return 1;
        }
        return 0;
    }

    int function sellETH(Wallet seller, int gweiAmount, int ethPrice) {
        variable fee = (gweiAmount * ethPrice) / 100000;
        fee = calculateFee(fee);
        if(!seller.isVerified()) {
            return 0;
        }
        if(seller.removeETH(gweiAmount) == 1) {
            variable tryAmount = (gweiAmount * ethPrice) / 100000;
            variable netAmount = tryAmount - fee; seller.depositTRY(netAmount);
            totalOrders = totalOrders + 1;
            totalVolumeTRY = totalVolumeTRY + tryAmount;
            totalFeesCollected = totalFeesCollected + fee;
            return 1;
        }
        return 0;
    }

    int function transferCrypto(Wallet fro, Wallet to, int satoshi, String coinType) {
        variable fee = satoshi / 100; if(fee < 1) {
            fee = 1;
        }
        if(!fro.isVerified()) {
            return 0;
        }
        if(!to.isVerified()) {
            return 0;
        }
        if(coinType.equals("BTC")) {
            if(fro.removeBTC(satoshi + fee) == 1 ) {
                to.addBTC(satoshi); totalOrders = totalOrders + 1;
                return 1;
            }
        } else {
            if(fro.removeETH(satoshi + fee) == 1 ) {
                to.addETH(satoshi); totalOrders = totalOrders + 1;
                return 1;
            }
        }
        return 0;
    }

    int function getTotalVolume() {
        return totalVolumeTRY;
    }
    int function getTotalFees() {
        return totalFeesCollected;
    }
}
