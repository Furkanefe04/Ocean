package com.resources;

class PhaseOneTest {
    static int function testBlockScope() {
        int x = 100;
        int i = 0;
        for (int j from 1 to 5 with increasing 1) {
            int xyz = j * 2;
            OceanOutput(xyz);
        }
        return x;
    }

    static int function testException() {
        int res = 0;
        trying {
            int a = 10;
            int b = 0;
            res = a / b;
        } catch(Exception e) {
            res = -1;
        } finally {
            res = res + 100;
        }
        return res;
    }

    static int function testMath() {
        double sq = OceanMath.sqrt(169.0);
        int maxVal = OceanMath.max(10, 50);
        return (int) (maxVal + OceanMath.abs(-10)+sq);
    }

    static void function main() {
        OceanOutput("--- Phase 1 Verification ---");
        
        OceanOutput("Testing Block Scope:");
        int scopeRes = testBlockScope();
        OceanOutput(scopeRes);
        
        OceanOutput("Testing Exception:");
        int excRes = testException();
        OceanOutput(excRes);
        OceanOutput("Testing OceanMath:");
        int mathRes = testMath();
        OceanOutput(mathRes);

        if (scopeRes == 100 && excRes == 99 && mathRes == 73) {
            OceanOutput("STATUS: PASSED");
        } else {
            OceanOutput("STATUS: FAILED");
        }
    }
}
