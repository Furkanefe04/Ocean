# =========================================================================
# Ocean Programming Language — .gitattributes
# =========================================================================

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF for Unix scripts & Gradle wrapper
gradlew text eol=lf
*.sh text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code & grammars
*.java text eol=lf
*.g4 text eol=lf
*.ocean text eol=lf linguist-language=Kotlin linguist-detectable=true
*.oc text eol=lf linguist-language=Kotlin linguist-detectable=true
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf

# GitHub Linguist Overrides
# Mark ANTLR generated code and build output as generated so it doesn't pollute language stats
src/generated/** linguist-generated=true
build/** linguist-generated=true

# Mark documentation & benchmark suites
benchmarks/** linguist-documentation=true
examples/** linguist-detectable=true

# Binary files
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
